GET http://localhost:5281/users
X-API-TOKEN: super-secret-token123

### Get all users
GET http://localhost:5281/users
X-API-TOKEN: super-secret-token123
Accept: application/json


### Get a specific user by ID
GET http://localhost:5281/users/1
X-API-TOKEN: super-secret-token123
Accept: application/json


### Create a new user
POST http://localhost:5281/users
X-API-TOKEN: super-secret-token123
Content-Type: application/json

{
  "firstName": "Alice",
  "lastName": "Johnson",
  "email": "alice@example.com"
}


### Update an existing user
PUT http://localhost:5281/users/1
X-API-TOKEN: super-secret-token123
Content-Type: application/json


### Delete a user by ID
DELETE http://localhost:5281/users/1
X-API-TOKEN: super-secret-token123
Content-Type: application/json